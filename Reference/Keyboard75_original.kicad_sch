      (instances (project "Keyboard75_Exploded_ANSI" (path "/69d249a4-d37d-52f9-94c7-cf90fccf8bbb" (reference "H6")(unit 1))))) (text "82-key exploded ANSI / Windows layout / Rev A"(at 340 285 0)(effects (font (size 1.5 1.5)))(uuid "8b02c8ad-0654-5185-90c5-3c756bb3f685")) (text "7 x 12 matrix. Switch pin 1 = column; diode cathode = row."(at 340 292 0)(effects (font (size 1.5 1.5)))(uuid "e511841a-ba6c-56e4-8fd7-e3f6ad634e71")) (text "QMK DIODE_DIRECTION = COL2ROW. GP29 header is unused."(at 340 299 0)(effects (font (size 1.5 1.5)))(uuid "64c3a2d2-ab3f-57fc-a8a4-36ebe39b92c4")) (text "ROW0..6 = GP0..6; COL0..8 = GP7..15; COL9..11 = GP26..28."(at 340 306 0)(effects (font (size 1.5 1.5)))(uuid "1c1a640a-48ae-5979-8682-3a32ad7c0612")) (text "U1 is the original Waveshare RP2040-Zero USB-C module."(at 340 313 0)(effects (font (size 1.5 1.5)))(uuid "3eab09d0-d133-5c00-ad33-c32f2d8ac6fb")) (text "USB, RP2040, flash, regulator and decoupling are on the module."(at 340 320 0)(effects (font (size 1.5 1.5)))(uuid "ebcb7ed0-1d35-572e-b029-afeec74cf62f")) (text "82 x Kailh CPG151101S11 sockets on the bottom."(at 340 327 0)(effects (font (size 1.5 1.5)))(uuid "cd35ca40-f0ac-5d5d-9148-e5444484261c")) (text "82 x 1N4148W SOD-123 diodes on the bottom."(at 340 334 0)(effects (font (size 1.5 1.5)))(uuid "caf9d084-d31f-54d8-9bad-81e00c503d2a")) (text "Prototype: confirm module, switches, stabilizers and case fit before ordering."(at 340 341 0)(effects (font (size 1.5 1.5)))(uuid "bc64e179-7725-5ce4-a197-a97494f9b760"))
 (sheet_instances (path "/" (page "1"))))
